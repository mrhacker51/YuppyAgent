{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuppyCode",
  "version": "0.1.0",
  "identifier": "com.yuppycode.desktop",
  "build": {
    "devUrl": "http://localhost:3434",
    "frontendDist": "../../ui/out"
  },
  "app": {
    "windows": [
      {
        "title": "YuppyCode — Agent Command Center",
        "width": 1600,
        "height": 950,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; frame-src http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "externalBin": ["binaries/yuppy"]
  }
}
